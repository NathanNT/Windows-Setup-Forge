<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Windows Setup Manager"
    Width="1180"
    Height="840"
    MinWidth="980"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    Background="#101214"
    Foreground="#E6EAF0"
    FontFamily="Segoe UI"
    FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#101214" />
        <SolidColorBrush x:Key="Panel" Color="#171A1F" />
        <SolidColorBrush x:Key="PanelAlt" Color="#1E232B" />
        <SolidColorBrush x:Key="Border" Color="#303743" />
        <SolidColorBrush x:Key="Text" Color="#E6EAF0" />
        <SolidColorBrush x:Key="Muted" Color="#9AA7B5" />
        <SolidColorBrush x:Key="Accent" Color="#4DA3FF" />
        <SolidColorBrush x:Key="AccentDark" Color="#2377CC" />
        <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
        <SolidColorBrush x:Key="Success" Color="#5ED39D" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#252B34" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2F3742" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#384453" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#11151A" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CaretBrush" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" SnapsToDevicePixels="True">
                            <ScrollViewer Background="{TemplateBinding Background}" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#222933" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1F3A55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="#171A1F" />
            <Setter Property="AlternatingRowBackground" Value="#191D23" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202630" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#212832" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#24384C" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
            <RowDefinition Height="96" />
            <RowDefinition Height="154" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentDark}" Margin="0,0,12,0">
                        <TextBlock Text="W" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Windows Setup Manager" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="AdminStatusText" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Muted}" />
                <Button x:Name="RestartAdminButton" Grid.Column="2" Content="Restart as admin" Margin="0,0,12,0" Visibility="Collapsed" />
                <Border Grid.Column="3" Background="#10251C" BorderBrush="#255C43" BorderThickness="1" CornerRadius="7" Padding="12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="WingetStatusText" Text="WinGet..." Foreground="{StaticResource Success}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock Text="Categories" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="4,0,0,10" DockPanel.Dock="Top" />
                    <ListBox x:Name="CategoryList" Background="{StaticResource Panel}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBox x:Name="SearchBox" />
                        <TextBlock
                            x:Name="SearchPlaceholder"
                            Text="Search for an application..."
                            Foreground="{StaticResource Muted}"
                            IsHitTestVisible="False"
                            Margin="13,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>

                    <DataGrid
                        x:Name="AppGrid"
                        Grid.Row="2"
                        RowHeight="58"
                        AlternationCount="2"
                        IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="48" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="62" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="42"
                                            Height="42"
                                            CornerRadius="10"
                                            Background="#11151A"
                                            BorderBrush="{StaticResource Border}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <Grid>
                                                <Image
                                                    Width="34"
                                                    Height="34"
                                                    Stretch="Uniform"
                                                    Source="{Binding LogoUri}"
                                                    Visibility="{Binding LogoImageVisibility}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Text="{Binding LogoText}"
                                                    Visibility="{Binding LogoBadgeVisibility}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Foreground="White" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Application" Width="2.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SelectAllButton" Grid.Column="0" Content="Select all" Margin="0,0,8,0" />
                        <Button x:Name="ClearSelectionButton" Grid.Column="1" Content="Clear all" Margin="0,0,8,0" />
                        <Button x:Name="RecommendedButton" Grid.Column="2" Content="Recommended" />
                        <CheckBox x:Name="ReinstallInstalledCheck" Grid.Column="4" Content="Reinstall applications already present" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="VM Deployment" FontWeight="SemiBold" />
                    <TextBlock x:Name="VmEnvironmentText" Grid.Row="1" Text="Environment: checking..." Foreground="{StaticResource Muted}" Margin="0,5,0,8" TextTrimming="CharacterEllipsis" />
                    <UniformGrid Grid.Row="2" Columns="2" Rows="2">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="VMware Tools" Foreground="{StaticResource Muted}" FontSize="12" />
                            <TextBlock x:Name="VmwareToolsStatusText" Text="Unknown" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="VirtualBox Additions" Foreground="{StaticResource Muted}" FontSize="12" />
                            <TextBlock x:Name="VirtualBoxToolsStatusText" Text="Unknown" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Margin="0,6,12,0">
                            <TextBlock Text="Remote Desktop" Foreground="{StaticResource Muted}" FontSize="12" />
                            <TextBlock x:Name="RemoteDesktopStatusText" Text="Unknown" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Margin="0,6,12,0">
                            <TextBlock Text="Sticky/Filter Keys" Foreground="{StaticResource Muted}" FontSize="12" />
                            <TextBlock x:Name="StickyKeysStatusText" Text="Unknown" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </UniformGrid>
                </Grid>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Actions" Foreground="{StaticResource Muted}" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="RefreshVmStatusButton" Content="Refresh VM status" Margin="0,0,8,8" MinWidth="140" />
                        <Button x:Name="InstallVmwareToolsButton" Content="Install VMware Tools" Margin="0,0,8,8" MinWidth="150" />
                        <Button x:Name="InstallVirtualBoxToolsButton" Content="Install VirtualBox Additions" Margin="0,0,8,8" MinWidth="190" />
                        <Button x:Name="EnableRemoteDesktopButton" Content="Enable RDP" Margin="0,0,8,8" MinWidth="110" />
                        <Button x:Name="DisableStickyKeysButton" Content="Disable Sticky/Filter Keys" Margin="0,0,8,8" MinWidth="190" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectedCountText" Text="0 applications selected" FontWeight="SemiBold" />
                    <TextBlock x:Name="ProgressText" Grid.Column="1" Text="Ready" Foreground="{StaticResource Muted}" />
                </Grid>

                <TextBlock x:Name="CurrentAppText" Grid.Row="1" Text="No operation in progress" Foreground="{StaticResource Muted}" Margin="0,8,0,8" />
                <ProgressBar x:Name="GlobalProgressBar" Grid.Row="2" Height="14" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Accent}" Background="#0B0E12" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Logs" FontWeight="SemiBold" />
                    <TextBlock x:Name="SummaryText" Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" Text="Successful 0 | Already installed 0 | Skipped 0 | Failed 0" />
                </Grid>
                <TextBox
                    x:Name="LogBox"
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    FontFamily="Consolas"
                    FontSize="12"
                    TextWrapping="NoWrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="VerifyButton" Grid.Column="0" Content="Check applications" Margin="0,0,10,0" />
            <Button x:Name="UpgradeButton" Grid.Column="1" Content="Update applications" Margin="0,0,10,0" />
            <Button x:Name="Win11DebloatButton" Grid.Column="2" Content="Run Win11Debloat" Margin="0,0,10,0" ToolTip="Download the official Win11Debloat GitHub archive and launch Win11Debloat.ps1." />
            <Button x:Name="CustomScriptButton" Grid.Column="3" Content="Run custom script" Margin="0,0,10,0" ToolTip="Run custom\CustomScript.ps1 from this project." />
            <Button x:Name="ActivationSettingsButton" Grid.Column="4" Content="Activation settings" />
            <Button x:Name="InstallButton" Grid.Column="6" Content="Install" Style="{StaticResource PrimaryButton}" MinWidth="130" />
        </Grid>
    </Grid>
</Window>
